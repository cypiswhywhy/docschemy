{
  "uid": "claude-code-deep-dive",
  "title": "Claude Code — Deep Dive",
  "tags": ["claude-code"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": { "type": "loki", "uid": "claude-loki" },
        "query": { "label": "project", "refId": "project", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "API requests", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Request latency", "id": 1,
      "description": "End-to-end duration of each model call, from the api_request event.",
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "quantile_over_time(0.5, {service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_request\" | unwrap duration_ms [$__auto])", "legendFormat": "p50" },
        { "refId": "B", "expr": "quantile_over_time(0.95, {service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_request\" | unwrap duration_ms [$__auto])", "legendFormat": "p95" },
        { "refId": "C", "expr": "max_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_request\" | unwrap duration_ms [$__auto])", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries", "title": "Request rate by model", "id": 2,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [{ "refId": "A", "expr": "sum by (model) (count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_request\" [$__auto]))", "legendFormat": "{{model}}" }]
    },
    {
      "type": "table", "title": "Most expensive requests", "id": 3,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "cost_usd", "desc": true }] },
      "targets": [{ "refId": "A", "expr": "{service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_request\" | line_format \"\"", "queryType": "range", "maxLines": 200 }],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        { "id": "organize", "options": { "includeByName": {}, "excludeByName": { "labels": true, "Line": true, "id": true, "tsNs": true, "user_email": true, "user_id": true, "user_account_id": true, "user_account_uuid": true, "organization_id": true, "os_type": true, "os_version": true, "host_arch": true, "service_version": true, "scope_name": true, "scope_version": true, "observed_timestamp": true, "flags": true, "detected_level": true, "service_name": true }, "indexByName": { "Time": 0, "project": 1, "model": 2, "query_source": 3, "cost_usd": 4, "duration_ms": 5, "input_tokens": 6, "output_tokens": 7, "cache_read_tokens": 8, "cache_creation_tokens": 9 } } }
      ]
    },

    { "type": "row", "title": "Tools", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Tool calls by name", "id": 10,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [{ "refId": "A", "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"tool_result\" [$__auto]))", "legendFormat": "{{tool_name}}" }]
    },
    {
      "type": "timeseries", "title": "Tool duration p95, by tool", "id": 11,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] } },
      "targets": [{ "refId": "A", "expr": "quantile_over_time(0.95, {service_name=\"claude-code\", project=~\"$project\"} | event_name=\"tool_result\" | unwrap duration_ms [$__auto]) by (tool_name)", "legendFormat": "{{tool_name}}" }]
    },
    {
      "type": "timeseries", "title": "Failed tool calls", "id": 12,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 }, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [{ "refId": "A", "expr": "sum by (tool_name, error_type) (count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"tool_result\" | success=\"false\" [$__auto]))", "legendFormat": "{{tool_name}} {{error_type}}" }]
    },
    {
      "type": "timeseries", "title": "Permission decisions", "id": 13,
      "description": "Where the decision came from: config allowlist, a hook, or you at the prompt.",
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [{ "refId": "A", "expr": "sum by (decision, source) (count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"tool_decision\" [$__auto]))", "legendFormat": "{{decision}} via {{source}}" }]
    },

    { "type": "row", "title": "Failures", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false },
    {
      "type": "timeseries", "title": "API errors and refusals", "id": 20,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status_code) (count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_error\" [$__auto]))", "legendFormat": "error {{status_code}}" },
        { "refId": "B", "expr": "sum(count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"api_refusal\" [$__auto]))", "legendFormat": "refusal" }
      ]
    },
    {
      "type": "logs", "title": "Error and refusal events", "id": 21,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 35 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [{ "refId": "A", "expr": "{service_name=\"claude-code\", project=~\"$project\"} | event_name=~\"api_error|api_refusal|internal_error\"", "maxLines": 200 }]
    },
    {
      "type": "timeseries", "title": "MCP server connections", "id": 22,
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80, "lineWidth": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [{ "refId": "A", "expr": "sum by (server_name, status) (count_over_time({service_name=\"claude-code\", project=~\"$project\"} | event_name=\"mcp_server_connection\" [$__auto]))", "legendFormat": "{{server_name}} {{status}}" }]
    },

    { "type": "row", "title": "Prompts and traces", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 }, "collapsed": false },
    {
      "type": "logs", "title": "Prompts", "id": 30,
      "description": "Prompt text appears only when OTEL_LOG_USER_PROMPTS=1.",
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 50 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [{ "refId": "A", "expr": "{service_name=\"claude-code\", project=~\"$project\"} | event_name=\"user_prompt\"", "maxLines": 200 }]
    },
    {
      "type": "table", "title": "Recent traces", "id": 31,
      "description": "Requires CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1. Click a trace to open the span tree.",
      "datasource": { "type": "tempo", "uid": "claude-tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 50 },
      "options": { "showHeader": true },
      "targets": [{ "refId": "A", "queryType": "traceql", "query": "{resource.service.name=\"claude-code\"}", "limit": 50, "tableType": "traces" }]
    }
  ]
}
