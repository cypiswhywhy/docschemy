{
  "uid": "claude-code-overview",
  "title": "Claude Code \u2014 Overview",
  "tags": [
    "claude-code"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "claude-loki"
        },
        "query": {
          "label": "project",
          "refId": "project",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Spend and usage \u2014 exact, summed from per-request events",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Spend",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | unwrap cost_usd [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Sum of cost_usd across every api_request event in range. Exact \u2014 not a PromQL rate estimate."
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Tokens",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | label_format tot=`{{ add .input_tokens .output_tokens .cache_read_tokens .cache_creation_tokens }}` | unwrap tot [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "API requests",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Spend per request",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | unwrap cost_usd [$__range])) / sum(count_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Cache read share",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | unwrap cache_read_tokens [$__range])) / sum(sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | label_format tot=`{{ add .input_tokens .output_tokens .cache_read_tokens .cache_creation_tokens }}` | unwrap tot [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Share of all tokens served from cache. Cache reads bill far below fresh input, so higher is cheaper."
    },
    {
      "type": "row",
      "title": "Where the money goes",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Spend over time, by model",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | unwrap cost_usd [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "piechart",
      "id": 11,
      "title": "Spend by project",
      "datasource": {
        "type": "loki",
        "uid": "claude-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^Value.*$/"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project) (sum_over_time({service_name=~\"claude-code.*\", project=~\"$project\"} | event_name=\"api_request\" | unwrap cost_usd [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{project}}"
        }
      ],
      "description": "Requires OTEL_RESOURCE_ATTRIBUTES=project=<name>; sessions without it group under an empty label."
    },
    {
      "type": "timeseries",
