# Copy to .env to override. All services bind to 127.0.0.1 only.

# Port Claude Code pushes OTLP/gRPC telemetry to.
OTLP_GRPC_PORT=4317
# Port for OTLP/HTTP, if you prefer http/protobuf over gRPC.
OTLP_HTTP_PORT=4318
# Grafana UI.
GRAFANA_PORT=3000
# Prometheus UI, for debugging queries directly.
PROMETHEUS_PORT=9090

# How long to keep data. Metrics are small; events with content logging are not.
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=4GB

# Loki stops accepting writes when the disk holding its volume is this full
# (0 disables the guard). Rootless Docker stores volumes under $HOME.
LOKI_WAL_DISK_THRESHOLD=0.95

# Loki retention lives in loki/loki.yaml (limits_config.retention_period),
# default 2160h = 90d, matching Prometheus.
